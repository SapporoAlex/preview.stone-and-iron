---
// Image carousel (replaces Elementor "Slides"): slides move sideways,
// autoplay every few seconds, previous/next arrows, dots, swipe on touch.
// Optional captions turn it into the "Recommendation" style with a title,
// Japanese name and a "More" link over a darkened photo.
//
// <Carousel slides={[{ image: '/images/a.jpg' }]} />
// <Carousel slides={spots} height="sm" captions />
export interface Slide {
  image: string;
  title?: string;
  subtitle?: string;
  url?: string;
}

interface Props {
  slides: Slide[];
  label: string; // accessible name, e.g. "客室の写真"
  height?: 'sm' | 'md' | 'lg'; // 400px / 573px / 573px-wide
  captions?: boolean;
  interval?: number; // ms
}

const { slides, label, height = 'md', captions = false, interval = 5000 } = Astro.props;
---

<div
  class:list={['carousel', `carousel--${height}`, { 'carousel--captions': captions }]}
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
  data-carousel
  data-interval={interval}
>
  <div class="carousel__track" data-carousel-track>
    {
      slides.map((slide, i) => (
        <div
          class="carousel__slide"
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} / ${slides.length}`}
          style={`background-image: url('${slide.image}')`}
        >
          {captions && (
            <div class="carousel__caption">
              {slide.title && <p class="carousel__title">{slide.title}</p>}
              {slide.subtitle && <p class="carousel__subtitle">{slide.subtitle}</p>}
              {slide.url && (
                <a class="carousel__more" href={slide.url} target="_blank" rel="noopener">
                  More
                </a>
              )}
            </div>
          )}
        </div>
      ))
    }
  </div>

  <button class="carousel__arrow carousel__arrow--prev" type="button" data-carousel-prev>
    <span class="visually-hidden">前へ</span>
  </button>
  <button class="carousel__arrow carousel__arrow--next" type="button" data-carousel-next>
    <span class="visually-hidden">次へ</span>
  </button>

  {
    !captions && (
      <div class="carousel__dots" data-carousel-dots>
        {slides.map((_, i) => (
          <button class="carousel__dot" type="button" aria-label={`${i + 1}枚目を表示`} data-index={i} />
        ))}
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const slides = track ? [...track.children] : [];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-carousel-dots] button')];
    const interval = Number(root.dataset.interval) || 5000;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer: number | undefined;

    const go = (i: number) => {
      index = (i + slides.length) % slides.length;
      if (track) track.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach((d, n) => d.setAttribute('aria-current', String(n === index)));
    };

    const start = () => {
      stop();
      if (!reduceMotion && slides.length > 1) timer = window.setInterval(() => go(index + 1), interval);
    };
    const stop = () => window.clearInterval(timer);

    root.querySelector('[data-carousel-prev]')?.addEventListener('click', () => { go(index - 1); start(); });
    root.querySelector('[data-carousel-next]')?.addEventListener('click', () => { go(index + 1); start(); });
    dots.forEach((d) => d.addEventListener('click', () => { go(Number(d.dataset.index)); start(); }));

    // Pause while hovered or focused, resume after.
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);

    // Swipe on touch screens.
    let startX = 0;
    root.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; stop(); }, { passive: true });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) go(index + (dx < 0 ? 1 : -1));
      start();
    });

    go(0);
    start();
  });
</script>

<style lang="scss">
  .carousel {
    position: relative;
    overflow: hidden;

    &__track {
      display: flex;
      height: 100%;
      transition: transform 0.6s $ease-out;
    }

    &__slide {
      position: relative;
      flex: 0 0 100%;
      height: 100%;
      background-size: cover;
      background-position: center;
    }

    &--sm {
      height: clamp(260px, 30vw, 400px);
    }

    &--md {
      aspect-ratio: 1003 / 573;
    }

    // Arrows: plain chevrons on the photo edges.
    &__arrow {
      position: absolute;
      top: 50%;
      width: 44px;
      height: 44px;
      margin-top: -22px;
      padding: 0;
      background: none;
      border: 0;
      color: rgba($color-white, 0.9);
      transition: color $transition-base;

      &::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 14px;
        height: 14px;
        border-top: 2px solid currentColor;
        border-left: 2px solid currentColor;
      }

      &--prev {
        left: 0.5rem;

        &::before {
          transform: translate(-30%, -50%) rotate(-45deg);
        }
      }

      &--next {
        right: 0.5rem;

        &::before {
          transform: translate(-70%, -50%) rotate(135deg);
        }
      }

      &:hover {
        color: $color-gold;
      }
    }

    &__dots {
      position: absolute;
      bottom: 0.75rem;
      left: 0;
      right: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px;
      padding-inline: 3rem;
    }

    &__dot {
      width: 6px;
      height: 6px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: rgba($color-white, 0.5);
      transition: background $transition-base;

      &[aria-current='true'] {
        background: $color-white;
      }
    }

    // --- Recommendation style (captions over a darkened photo) ---
    &--captions &__slide::before {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba($color-black, 0.35);
    }

    &__caption {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: 100%;
      max-width: calc(#{$container-max} + #{$gutter * 2});
      margin-inline: auto;
      padding-inline: clamp(3rem, 14vw, 13rem) $gutter;
      color: $color-white;
    }

    &__title {
      font-family: $font-display;
      font-size: clamp(2rem, 4vw, 3.125rem); // 50px
      line-height: 1;
      letter-spacing: 4.4px;
    }

    &__subtitle {
      margin-top: 1rem;
      font-family: $font-body;
      font-weight: 400;
      font-size: 1.0625rem;
      line-height: 1.4;
    }

    &__more {
      align-self: flex-start;
      margin-top: 0.5rem;
      margin-left: 1rem;
      padding-bottom: 0.15rem;
      border-bottom: 1px solid currentColor;
      font-family: $font-display;
      font-size: 1.25rem;
      letter-spacing: 1.2px;

      &:hover {
        color: $color-gold;
      }
    }
  }
</style>
