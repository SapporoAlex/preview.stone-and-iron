---
// Text link sitting on a long thin arrow line ("Café Bar ⟶").
// The line stretches and the colour turns gold on hover.
interface Props {
  href: string;
  label: string;
  align?: 'left' | 'right' | 'center';
}

const { href, label, align = 'right' } = Astro.props;
---

<div class:list={['arrow-link-wrap', `arrow-link-wrap--${align}`]}>
  <a class="arrow-link" href={href}>
    <span class="arrow-link__label">{label}</span>
    <span class="arrow-link__line" aria-hidden="true"></span>
  </a>
</div>

<style lang="scss">
  .arrow-link-wrap {
    display: flex;

    &--right {
      justify-content: flex-end;
    }

    &--center {
      justify-content: center;
    }
  }

  .arrow-link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    min-width: 150px;
    @include text-link;
    transition: color $transition-base;

    &__line {
      position: relative;
      width: 100%;
      height: 1px;
      background: currentColor;
      transition: transform 0.4s $ease-out;
      transform-origin: left center;

      // Arrow head
      &::after {
        content: '';
        position: absolute;
        right: 0;
        top: -3px;
        width: 8px;
        height: 1px;
        background: currentColor;
        transform: rotate(35deg);
        transform-origin: right center;
      }
    }

    &:hover,
    &:focus-visible {
      color: $color-gold;
    }

    &:hover &__line {
      transform: scaleX(1.15);
    }
  }
</style>
