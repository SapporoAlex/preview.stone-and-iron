---
// Light grey footer, everything centred: logo, brand, contact info,
// menu (current page underlined) and legal line.
import { site, mainNav } from '@data/site';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<footer class="site-footer">
  <div class="container">
    <a class="site-footer__logo" href="/" aria-label={`${site.name} ホーム`} data-reveal="zoom">
      <img src={site.logo} alt="" width="40" height="40" loading="lazy" />
    </a>
    <p class="site-footer__tagline">{site.tagline}</p>
    <p class="site-footer__brand">{site.brand}</p>
    <p class="site-footer__strap">{site.strap}</p>

    <h2 class="site-footer__heading">Information :</h2>
    <address class="site-footer__contact">
      {site.contact.postcode} {site.contact.address}<br />
      <a href={site.contact.phoneHref}>{site.contact.phone}</a>
    </address>

    <nav aria-label="フッターメニュー">
      <ul class="site-footer__nav" role="list">
        {
          mainNav.map((item) => (
            <li>
              <a
                class:list={['site-footer__link', { 'is-current': isCurrent(item.href) }]}
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="site-footer__legal" role="list">
      {site.legal.map((item) => <li>{item}</li>)}
    </ul>
    <p class="site-footer__copyright">{site.copyright}</p>
  </div>
</footer>

<style lang="scss">
  .site-footer {
    padding-block: 3.5rem 1.5rem;
    background: $color-grey-light;
    color: $color-black;
    text-align: center;

    &__logo {
      display: inline-block;
      width: 40px;
    }

    &__tagline {
      margin-top: 1rem;
      font-family: $font-body;
      font-weight: 300;
      font-size: 0.6875rem; // 11px
      line-height: 1.5;
      letter-spacing: 2px;
    }

    &__brand {
      @include text-brand(1.5625rem); // 25px
      margin-top: 1.75rem;
    }

    &__strap {
      @include text-strap(0.9375rem); // 15px
      margin-top: 0.5rem;
    }

    &__heading {
      @include text-label(1.375rem); // 22px
      margin-top: 3rem;
    }

    &__contact {
      margin-top: 1rem;
      font-family: $font-body;
      font-style: normal;
      font-weight: 300;
      font-size: 0.75rem; // 12px
      line-height: 1.5;
      letter-spacing: 2.3px;
    }

    // Menu: Elementor "underline" pointer — a 1px line fades in on hover,
    // and stays under the current page.
    &__nav {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.25rem 0.5rem;
      margin: 1.5rem 0 0;
    }

    &__link {
      position: relative;
      display: block;
      padding: 0.6rem 0.9rem;
      font-family: $font-display;
      font-size: 0.9375rem; // 15px
      line-height: 1.3;
      letter-spacing: 2.4px;

      &::after {
        content: '';
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        height: 1px;
        background: currentColor;
        opacity: 0;
        transition: opacity $transition-base;
      }

      &:hover::after,
      &:focus-visible::after,
      &.is-current::after {
        opacity: 1;
      }
    }

    &__legal {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.25rem 1.5rem;
      margin: 1.25rem 0 0;
      font-family: $font-body;
      font-weight: 300;
      font-size: 0.6875rem;
      line-height: 1.8;
      letter-spacing: 2px;

      @include mq-down(md) {
        flex-direction: column;
      }
    }

    &__copyright {
      margin-top: 1rem;
      font-family: $font-body;
      font-weight: 300;
      font-size: 0.5rem; // 8px
      line-height: 1.8;
      letter-spacing: 3.4px;
    }
  }
</style>
