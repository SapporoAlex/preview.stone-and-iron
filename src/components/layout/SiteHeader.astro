---
// Fixed header over the page: dark gradient, small icon links on the left,
// menu button on the right that slides open a white menu panel.
import { site, mainNav } from '@data/site';

interface Props {
  showBooking?: boolean;
}

const { showBooking = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="site-header" data-site-header>
  <div class="site-header__bar">
    <ul class="site-header__quick" role="list">
      {
        showBooking && (
          <li>
            <a class="quick-link" href={site.links.booking} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 2v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2V2h-2v2H9V2H7zm-2 7h14v11H5V9zm2 2v2h2v-2H7zm4 0v2h2v-2h-2zm4 0v2h2v-2h-2z" />
              </svg>
              BOOK
            </a>
          </li>
        )
      }
      {
        site.links.english && (
          <li>
            <a class="quick-link" href={site.links.english} lang="en">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.9 6h-2.9a15.6 15.6 0 0 0-1.4-3.6A8 8 0 0 1 18.9 8zM12 4c.8 1.2 1.5 2.5 1.9 4h-3.8c.4-1.5 1.1-2.8 1.9-4zM4.3 14a8.2 8.2 0 0 1 0-4h3.4a16.5 16.5 0 0 0 0 4H4.3zm.8 2h2.9c.3 1.3.8 2.5 1.4 3.6A8 8 0 0 1 5.1 16zM8 8H5.1a8 8 0 0 1 4.3-3.6C8.8 5.5 8.3 6.7 8 8zm4 12c-.8-1.2-1.5-2.5-1.9-4h3.8c-.4 1.5-1.1 2.8-1.9 4zm2.3-6H9.7a14.7 14.7 0 0 1 0-4h4.6a14.7 14.7 0 0 1 0 4zm.3 5.6c.6-1.1 1.1-2.3 1.4-3.6h2.9a8 8 0 0 1-4.3 3.6zm1.7-5.6a16.5 16.5 0 0 0 0-4h3.4a8.2 8.2 0 0 1 0 4h-3.4z" />
              </svg>
              EN
            </a>
          </li>
        )
      }
    </ul>

    <div class="site-menu" data-menu>
      <button class="site-menu__toggle" type="button" aria-expanded="false" aria-controls="site-menu-panel" data-menu-toggle>
        <span class="visually-hidden">メニュー</span>
        <span class="site-menu__icon" aria-hidden="true"></span>
      </button>

      <nav class="site-menu__panel" id="site-menu-panel" aria-label="メインメニュー">
        <div class="site-menu__inner">
          <a class="site-menu__logo" href="/" aria-label={`${site.name} ホーム`}>
            <img src={site.logo} alt="" width="40" height="40" />
          </a>
          <ul class="site-menu__list" role="list">
            {
              mainNav.map((item) => (
                <li>
                  <a
                    class="site-menu__link"
                    href={item.href}
                    aria-current={currentPath === item.href ? 'page' : undefined}
                    {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="site-menu__social">
            <a href={site.links.facebook} target="_blank" rel="noopener" aria-label="Facebook">
              <img src="/images/brand/icon-facebook.png" alt="" width="24" height="24" />
            </a>
            <a href={site.links.instagramHotel} target="_blank" rel="noopener" aria-label="Instagram">
              <img src="/images/brand/icon-instagram.png" alt="" width="24" height="24" />
            </a>
          </div>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('is-open', open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

  // Close with Escape or a click outside the menu.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (menu?.classList.contains('is-open') && !menu.contains(e.target as Node)) setOpen(false);
  });
</script>

<style lang="scss">
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: $header-height;
    background: linear-gradient(180deg, rgba($color-black, 0.75) 0%, rgba($color-black, 0) 100%);
    pointer-events: none; // clicks pass through the gradient; children re-enable

    &__bar {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      padding: 10px;
    }

    &__quick {
      display: flex;
      gap: 0.5rem;
      margin: 0;
      pointer-events: auto;
    }
  }

  // Small icon-over-label links (BOOK, EN)
  .quick-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    min-width: 52px;
    padding: 0.4rem 0.25rem;
    font-family: $font-display;
    font-size: 0.8125rem;
    line-height: 1.2;
    letter-spacing: 2.8px;
    color: $color-white;
    transition: color $transition-base;

    svg {
      width: 20px;
      height: 20px;
      fill: currentColor;
    }

    &:hover,
    &:focus-visible {
      color: $color-gold;
    }
  }

  // --------------------------------------------------------------------------
  // Menu (toggle + slide-down panel)
  // --------------------------------------------------------------------------
  .site-menu {
    position: relative;
    pointer-events: auto;

    &__toggle {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      background: none;
      border: 0;
      color: $color-white;
      transition: color $transition-base;

      &:hover {
        color: $color-gold;
      }
    }

    // Two "grip lines" that turn into a cross when open.
    &__icon,
    &__icon::before {
      display: block;
      width: 18px;
      height: 2px;
      background: currentColor;
      transition: transform $transition-base;
    }

    &__icon {
      position: relative;
      transform: translateY(-3px);

      &::before {
        content: '';
        position: absolute;
        top: 6px;
      }
    }

    &.is-open &__icon {
      transform: rotate(45deg);

      &::before {
        transform: translateY(-6px) rotate(-90deg);
      }
    }

    // Panel slides down (grid row 0fr → 1fr animates the real height).
    &__panel {
      position: absolute;
      top: 100%;
      right: 0;
      display: grid;
      grid-template-rows: 0fr;
      min-width: 220px;
      background: $color-white;
      box-shadow: 0 6px 20px rgba($color-black, 0.15);
      visibility: hidden;
      transition:
        grid-template-rows 0.4s $ease-out,
        visibility 0.4s;
    }

    &.is-open &__panel {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    &__inner {
      overflow: hidden;
      padding-inline: 30px;
    }

    &__logo {
      display: block;
      width: 40px;
      margin-top: 1rem;
    }

    &__list {
      margin: 0.25rem 0 0;
    }

    &__link {
      display: block;
      font-family: $font-display;
      font-size: 1.0625rem;
      line-height: 51px;
      letter-spacing: 1.2px;
      color: $color-black;
      transition: color $transition-base;

      &:hover,
      &:focus-visible,
      &[aria-current='page'] {
        color: $color-gold;
      }
    }

    &__social {
      display: flex;
      gap: 0.75rem;
      padding-block: 0.75rem 1.25rem;

      a {
        transition: opacity $transition-base;
      }

      a:hover {
        opacity: 0.6;
      }

      img {
        width: 24px;
        height: 24px;
      }
    }
  }
</style>
