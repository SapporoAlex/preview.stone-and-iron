---
// The page shell used by every page: <head>, header, footer and global scripts.
import '@styles/global.scss';
import SiteHeader from '@components/layout/SiteHeader.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import FaqDialog from '@components/sections/FaqDialog.astro';
import { site } from '@data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string; // social share image
  theme?: 'light' | 'dark'; // dark = Café Bar page (night background, gold text)
  showBooking?: boolean; // "BOOK" link in the header (Stay page)
  showFaq?: boolean; // floating FAQ button + popup (Stay, Café Bar)
  showFooter?: boolean; // the home page is a full-screen hero without footer
  preloadImage?: string; // main image at the top of the page, fetched early for faster loading
}

const {
  title,
  description = site.description,
  image = '/images/home/slide-01.jpg',
  theme = 'light',
  showBooking = false,
  showFaq = false,
  showFooter = true,
  preloadImage,
} = Astro.props;
const pageTitle = title ? `${title} - ${site.shortName}` : `${site.shortName} ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={site.logo} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Fonts load without blocking the first paint: text shows straight away
         in a fallback font and swaps when the web font arrives. -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@200;300&family=Crimson+Text&family=Noto+Serif+JP:wght@200;300;400&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@200;300&family=Crimson+Text&family=Noto+Serif+JP:wght@200;300;400&display=swap" /></noscript>
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
  </head>
  <body class:list={[`theme-${theme}`]}>
    <a class="skip-link" href="#main">コンテンツにスキップ</a>
    <SiteHeader showBooking={showBooking} />
    <main id="main">
      <slot />
    </main>
    {showFooter && <SiteFooter />}
    {showFaq && <FaqDialog />}

    <script>
      import { initReveal } from '../scripts/reveal';
      initReveal();
    </script>
  </body>
</html>

<style lang="scss" is:global>
  // Page themes. The header is fixed over the content (no reserved space),
  // so each page's first section starts behind the gradient header.
  .theme-dark {
    background: $color-night;
    color: $color-gold;
  }
</style>
