# Apache settings for the static build. Copied to dist/ automatically.

Options -Indexes
DirectoryIndex index.html index.php

# Custom 404 page generated by Astro (src/pages/404.astro)
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Old WordPress URLs that moved in the rebuild (permanent redirects)
  # Event post:            /elementor-588/       -> /event/tengu-cafe-2020/
  # Campaign page:         /どうみん割プラン/       -> /doumin-plan/
  # Old menu link:         /?page_id=90          -> /cafe-bar/
  RewriteRule ^elementor-588/?$ /event/tengu-cafe-2020/ [R=301,L]
  RewriteRule ^どうみん割プラン/?$ /doumin-plan/ [R=301,L]
  RewriteCond %{QUERY_STRING} ^page_id=90$
  RewriteRule ^$ /cafe-bar/? [R=301,L]

  # The English pages (/en/, /*_english-ver/) were not rebuilt. Until they
  # are, send visitors to the matching Japanese page instead of a 404.
  RewriteRule ^en/?$ / [R=302,L]
  RewriteRule ^([a-z-]+)_english-ver/?$ /$1/ [R=302,L]

  # Add a trailing slash to page URLs (/about-us -> /about-us/)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# Caching: long for assets (Astro fingerprints file names), short for HTML.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
